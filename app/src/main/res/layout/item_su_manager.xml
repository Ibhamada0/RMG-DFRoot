<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="62dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:background="?attr/rmgPanel">
    <ImageView android:id="@+id/iconApp" android:layout_width="32dp"
        android:layout_height="32dp" android:layout_marginEnd="14dp"
        android:contentDescription="SU manager icon"/>
    <TextView android:id="@+id/labelApp" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:maxLines="1" android:ellipsize="end" android:textSize="15sp"
        android:fontFamily="sans-serif-medium" android:textColor="?attr/rmgText"/>
</LinearLayout>