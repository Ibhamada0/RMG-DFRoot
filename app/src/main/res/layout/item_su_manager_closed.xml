<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:minHeight="54dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp">
    <ImageView android:id="@+id/iconApp" android:layout_width="30dp"
       android:layout_height="30dp" android:layout_marginEnd="12dp"
       android:contentDescription="Selected manager icon"/>
    <TextView android:id="@+id/labelApp" android:layout_width="0dp"
       android:layout_height="wrap_content" android:layout_weight="1"
       android:maxLines="1" android:ellipsize="end" android:textSize="15sp"
       android:fontFamily="sans-serif-medium" android:textColor="?attr/rmgText"/>
</LinearLayout>