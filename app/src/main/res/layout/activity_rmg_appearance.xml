<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/rmgBg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="22dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="RMP / APPEARANCE" android:textColor="?attr/rmgIce"
            android:letterSpacing="0.15" android:textSize="12sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Choose your experience"
            android:textColor="?attr/rmgText" android:textSize="28sp"
            android:fontFamily="sans-serif-medium"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Six curated palettes for your RMP control center"
            android:textColor="?attr/rmgSecondary" android:textSize="14sp"/>
        <RadioGroup android:id="@+id/themeGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:background="@drawable/rmg_theme_panel"
            android:orientation="vertical" android:padding="18dp">
            <RadioButton android:id="@+id/themeObsidian" android:layout_width="match_parent"
                 android:layout_height="58dp" android:buttonTint="?attr/rmgCyan"
                 android:text="Obsidian"
                 android:textColor="?attr/rmgText" android:textSize="16sp" />
            <RadioButton android:id="@+id/themeAurora" android:layout_width="match_parent"
                 android:layout_height="58dp" android:buttonTint="?attr/rmgCyan"
                 android:text="Aurora"
                 android:textColor="?attr/rmgText" android:textSize="16sp" />
            <RadioButton android:id="@+id/themeGlacier" android:layout_width="match_parent"
                 android:layout_height="58dp" android:buttonTint="?attr/rmgCyan"
                 android:text="Glacier"
                 android:textColor="?attr/rmgText" android:textSize="16sp" />
            <RadioButton android:id="@+id/themeEmber" android:layout_width="match_parent"
                 android:layout_height="58dp" android:buttonTint="?attr/rmgCyan"
                 android:text="Ember"
                 android:textColor="?attr/rmgText" android:textSize="16sp" />
            <RadioButton android:id="@+id/themeMatrix" android:layout_width="match_parent"
                 android:layout_height="58dp" android:buttonTint="?attr/rmgCyan"
                 android:text="Matrix"
                 android:textColor="?attr/rmgText" android:textSize="16sp" />
            <RadioButton android:id="@+id/themeHeritage" android:layout_width="match_parent"
                 android:layout_height="58dp" android:buttonTint="?attr/rmgCyan"
                 android:text="RMP Heritage • Root My Galaxy inspired"
                 android:textColor="?attr/rmgText" android:textSize="16sp" />
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textColor="?attr/rmgMuted"
            android:text="Appearance does not change rooting compatibility or backend."
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>